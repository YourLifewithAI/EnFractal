{
  "schema": "enfractal-phase2-authority-design-v1",
  "status": "unimplemented_test_vectors_not_wire_schema",
  "transport": {
    "server_bind": "127.0.0.1",
    "server_port": "os_assigned",
    "expected_hostname": "enfractal-test.invalid",
    "require_dtls_server_identity": true
  },
  "world_fixture": {
    "world_id": "fixture_world",
    "frame_id": "fixture_flat_cell",
    "authority_epoch": 1,
    "world_rules_revision": 1,
    "tick_hz": 30,
    "avatars": {
      "alice": "avatar_alice",
      "bob": "avatar_bob"
    },
    "ticket_refs": {
      "alice": "generated_ephemeral_ticket_for_alice",
      "bob": "generated_ephemeral_ticket_for_bob"
    }
  },
  "invariants": [
    "Client messages are intentions; only authority computes position and wind/glide effect.",
    "Authenticated principal and avatar come from the server-side ticket record bound to the encrypted connection, never from packet claims.",
    "Rejected messages do not mutate authority state at the same tick or disclose a world snapshot.",
    "Accepted snapshots for the same authority tick/revision agree for both admitted clients on shared fields.",
    "Movement sequence replay is separate from durable action_id receipt semantics, which are out of scope."
  ],
  "scenarios": [
    {
      "id": "two_clients_share_server_result",
      "steps": [
        {"kind": "connect_and_join", "client": "alice", "ticket_ref": "alice", "expect": "joined_as_avatar_alice"},
        {"kind": "connect_and_join", "client": "bob", "ticket_ref": "bob", "expect": "joined_as_avatar_bob"},
        {"kind": "intent", "client": "alice", "seq": 1, "move_x": 1.0, "move_z": 0.0, "glide": true, "expect": "accepted"},
        {"kind": "intent", "client": "bob", "seq": 1, "move_x": -1.0, "move_z": 0.0, "glide": false, "expect": "accepted"},
        {"kind": "advance_authority_tick", "count": 1},
        {"kind": "assert", "expect": "both_clients_receive_same_shared_positions_and_rule_revision_for_same_tick"},
        {"kind": "assert", "expect": "alice_glide_and_wind_effect_derived_from_server_rule_not_client_claim"},
        {"kind": "assert", "expect": "each_avatar_moves_within_server_speed_and_frame_bounds"}
      ]
    },
    {
      "id": "server_identity_must_precede_admission",
      "steps": [
        {"kind": "connect", "client": "alice", "certificate_expectation": "wrong_hostname", "expect": "handshake_rejected"},
        {"kind": "assert", "expect": "no_ticket_sent_no_session_no_world_snapshot"}
      ]
    },
    {
      "id": "missing_ticket_is_not_a_session",
      "steps": [
        {"kind": "connect", "client": "alice", "certificate_expectation": "valid", "expect": "encrypted_only"},
        {"kind": "join", "client": "alice", "ticket_ref": "missing", "expect": "admission_rejected"},
        {"kind": "intent", "client": "alice", "seq": 1, "move_x": 1.0, "move_z": 0.0, "glide": false, "expect": "not_admitted"},
        {"kind": "assert", "expect": "no_session_no_world_snapshot_no_state_change"}
      ]
    },
    {
      "id": "single_use_ticket",
      "steps": [
        {"kind": "connect_and_join", "client": "alice", "ticket_ref": "alice", "expect": "joined_as_avatar_alice"},
        {"kind": "connect", "client": "bob", "certificate_expectation": "valid", "expect": "encrypted_only"},
        {"kind": "join", "client": "bob", "ticket_ref": "alice", "expect": "admission_rejected"},
        {"kind": "assert", "expect": "bob_receives_no_alice_session_or_world_snapshot"}
      ]
    },
    {
      "id": "forged_position_rejected",
      "steps": [
        {"kind": "connect_and_join", "client": "alice", "ticket_ref": "alice", "expect": "joined_as_avatar_alice"},
        {"kind": "intent", "client": "alice", "seq": 1, "move_x": 0.0, "move_z": 0.0, "glide": false, "position_m": {"x": 1000000.0, "y": 1000000.0, "z": 1000000.0}, "expect": "forbidden_authority_field"},
        {"kind": "assert", "expect": "state_unchanged_at_same_tick"}
      ]
    },
    {
      "id": "forged_owner_and_actor_rejected",
      "steps": [
        {"kind": "connect_and_join", "client": "alice", "ticket_ref": "alice", "expect": "joined_as_avatar_alice"},
        {"kind": "intent", "client": "alice", "seq": 1, "move_x": 1.0, "move_z": 0.0, "glide": false, "owner_id": "bob", "avatar_id": "avatar_bob", "expect": "forbidden_authority_field"},
        {"kind": "assert", "expect": "alice_and_bob_state_unchanged_at_same_tick"}
      ]
    },
    {
      "id": "client_cannot_set_wind_or_rules",
      "steps": [
        {"kind": "connect_and_join", "client": "alice", "ticket_ref": "alice", "expect": "joined_as_avatar_alice"},
        {"kind": "intent", "client": "alice", "seq": 1, "move_x": 0.0, "move_z": 0.0, "glide": true, "wind_mps": {"x": 100.0, "y": 0.0, "z": 0.0}, "world_rules_revision": 999, "expect": "forbidden_authority_field"},
        {"kind": "assert", "expect": "server_rules_and_state_unchanged_at_same_tick"}
      ]
    },
    {
      "id": "duplicate_movement_sequence_is_not_twice_applied",
      "steps": [
        {"kind": "connect_and_join", "client": "alice", "ticket_ref": "alice", "expect": "joined_as_avatar_alice"},
        {"kind": "intent", "client": "alice", "seq": 1, "move_x": 1.0, "move_z": 0.0, "glide": false, "expect": "accepted"},
        {"kind": "advance_authority_tick", "count": 1},
        {"kind": "intent", "client": "alice", "seq": 1, "move_x": 1.0, "move_z": 0.0, "glide": false, "expect": "stale_sequence"},
        {"kind": "assert", "expect": "replay_does_not_enqueue_or_apply_second_intent"}
      ]
    },
    {
      "id": "sequence_cannot_be_reused_with_changed_payload",
      "steps": [
        {"kind": "connect_and_join", "client": "alice", "ticket_ref": "alice", "expect": "joined_as_avatar_alice"},
        {"kind": "intent", "client": "alice", "seq": 1, "move_x": 1.0, "move_z": 0.0, "glide": false, "expect": "accepted"},
        {"kind": "intent", "client": "alice", "seq": 1, "move_x": -1.0, "move_z": 0.0, "glide": true, "expect": "stale_sequence"},
        {"kind": "assert", "expect": "only_first_intent_can_affect_next_tick"}
      ]
    },
    {
      "id": "session_copied_to_other_connection_rejected",
      "steps": [
        {"kind": "connect_and_join", "client": "alice", "ticket_ref": "alice", "expect": "joined_as_avatar_alice"},
        {"kind": "connect_and_join", "client": "bob", "ticket_ref": "bob", "expect": "joined_as_avatar_bob"},
        {"kind": "intent", "client": "bob", "session_ref": "alice", "seq": 1, "move_x": 1.0, "move_z": 0.0, "glide": false, "expect": "session_connection_mismatch"},
        {"kind": "assert", "expect": "alice_and_bob_state_unchanged_at_same_tick"}
      ]
    },
    {
      "id": "stale_world_or_epoch_rejected",
      "steps": [
        {"kind": "connect_and_join", "client": "alice", "ticket_ref": "alice", "expect": "joined_as_avatar_alice"},
        {"kind": "intent", "client": "alice", "seq": 1, "world_id": "other_world", "frame_id": "fixture_flat_cell", "authority_epoch": 1, "move_x": 1.0, "move_z": 0.0, "glide": false, "expect": "target_mismatch"},
        {"kind": "intent", "client": "alice", "seq": 2, "world_id": "fixture_world", "frame_id": "fixture_flat_cell", "authority_epoch": 0, "move_x": 1.0, "move_z": 0.0, "glide": false, "expect": "stale_epoch"},
        {"kind": "assert", "expect": "state_unchanged_at_same_tick"}
      ]
    },
    {
      "id": "reconnect_fences_old_connection",
      "steps": [
        {"kind": "connect_and_join", "client": "alice_old", "ticket_ref": "alice", "expect": "joined_as_avatar_alice"},
        {"kind": "issue_new_ticket_for_same_avatar", "ticket_ref": "alice_reconnect"},
        {"kind": "connect_and_join", "client": "alice_new", "ticket_ref": "alice_reconnect", "expect": "replaces_old_session"},
        {"kind": "intent", "client": "alice_old", "seq": 1, "move_x": 1.0, "move_z": 0.0, "glide": false, "expect": "session_replaced"},
        {"kind": "intent", "client": "alice_new", "seq": 1, "move_x": 1.0, "move_z": 0.0, "glide": false, "expect": "accepted"},
        {"kind": "assert", "expect": "only_new_session_intent_can_affect_next_tick"}
      ]
    },
    {
      "id": "bounded_and_typed_messages",
      "steps": [
        {"kind": "connect_and_join", "client": "alice", "ticket_ref": "alice", "expect": "joined_as_avatar_alice"},
        {"kind": "intent", "client": "alice", "seq": 1, "move_x": 2.0, "move_z": 0.0, "glide": false, "expect": "parameter_out_of_range"},
        {"kind": "intent_raw", "client": "alice", "payload_kind": "non_finite_move_axis", "expect": "invalid_number"},
        {"kind": "intent_raw", "client": "alice", "payload_kind": "oversized_packet", "expect": "message_too_large"},
        {"kind": "intent_raw", "client": "alice", "payload_kind": "unknown_operation", "expect": "unsupported_operation"},
        {"kind": "assert", "expect": "no_bad_message_changes_state_or_unbounds_queue"}
      ]
    },
    {
      "id": "client_time_cannot_extend_effect",
      "steps": [
        {"kind": "connect_and_join", "client": "alice", "ticket_ref": "alice", "expect": "joined_as_avatar_alice"},
        {"kind": "intent", "client": "alice", "seq": 1, "move_x": 1.0, "move_z": 0.0, "glide": false, "client_elapsed_s": 3600.0, "expect": "forbidden_authority_field"},
        {"kind": "assert", "expect": "no_extra_duration_or_displacement"}
      ]
    },
    {
      "id": "private_fields_filtered_per_recipient",
      "steps": [
        {"kind": "connect_and_join", "client": "alice", "ticket_ref": "alice", "expect": "joined_as_avatar_alice"},
        {"kind": "connect_and_join", "client": "bob", "ticket_ref": "bob", "expect": "joined_as_avatar_bob"},
        {"kind": "advance_authority_tick", "count": 1},
        {"kind": "assert", "expect": "both_see_same_shared_fields_but_not_other_principal_private_field"}
      ]
    }
  ]
}
