*.gz binary
*.png binary
*.jpg binary
*.r16 binary
*.tif binary
*.blend binary
*.glb binary
*.mp4 binary
# Preserve the byte hash stored in the Blender asset manifests on every host.
tools/art/*.py text eol=lf

# JSON sources participate in map/style pins; checkout line endings must not change hashes.
game/styles/*.json text eol=lf
# Legacy package manifests pin CRLF feature bytes; preserve those exact hashes.
game/maps/barton_creek/*.json text eol=crlf

# New district packages use explicit LF bytes before hashing.
maps/pfluger_district/**/*.json text eol=lf
game/maps/pfluger_district/*.json text eol=lf
