*.gz binary
*.png binary
*.jpg binary
*.r16 binary
*.tif binary
*.blend binary
*.glb binary
*.mp4 binary
# Preserve the byte hash stored in the Blender asset manifests on every host.
tools/art/*.py text eol=lf

# Pinned contract data: hashes cover exact bytes. Generated rooms and examples are never converted
# (any file type, any platform); hand-edited JSON is normalised to LF on commit.
contracts/*.schema.json text eol=lf
contracts/examples/** -text
game/rooms/** -text
game/styles/**/*.json text eol=lf
# Canonical JSON golden fixture: the three languages hash these exact bytes, so Git never converts them.
game/tests/fixtures/kernel/** -text

# Godot rewrites import sidecars with LF on every host; a CRLF checkout then shows them modified after each import.
*.import text eol=lf

# Companion (A1): the proposed link schema is pinned like the contracts, the canonical JSON fixture copy
# stays byte-exact, and proposal patches must reach Windows checkouts byte-exact or git apply refuses them.
companion/schemas/*.json text eol=lf
companion/tests/fixtures/** -text
docs/companion/proposals/*.diff -text
docs/look/proposals/*.diff -text
