; Native EnFractal. The historical application name preserves existing local save paths; the window title follows the active scene.
config_version=5

[application]
config/name="EnFractal — Barton Creek local workshop"
run/main_scene="res://scenes/native_boot.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="EnFractal"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.62, 0.76, 0.82, 1)
