{
  "schema": "enfractal.style",
  "version": 1,
  "preset_id": "storybook_painterly",
  "preset_version": 1,
  "display_name": "Storybook painterly",
  "description": "First preset: one stylized storybook style in the spirit of Tiny Glade, a cozy and fanciful handmade diorama, never photorealistic. Soft bounced light; gently desaturated colour that follows the real clock and calendar, from deep blue nights through warm twilight pastels to golden afternoons, with short winter days and long summer ones; crisp detail within the player's reach, and a tilt-shift miniature blur from high views. DRAFT (Run 1, Look lane): tuned on the placeholder room against docs/look/LOOK-BIBLE.md; not yet submitted for the look gate, so it may still change in place.",
  "status": "draft",
  "look_bible": "docs/look/LOOK-BIBLE.md",
  "renderer": {
    "method": "forward_plus",
    "gi": { "mode": "voxelgi", "energy": 0.55, "bounce_feedback": 0.45 },
    "shadows": { "enabled": true, "softness": 0.55, "tint": "#4a4f78" },
    "ambient_occlusion": { "enabled": true, "intensity": 1.4, "radius_m": 0.16 },
    "glow": { "enabled": true, "intensity": 0.5, "bloom": 0.05 },
    "tonemap": { "mode": "filmic", "exposure": 0.95, "white": 2.5 }
  },
