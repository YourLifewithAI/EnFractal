{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enfractal.invalid/v1/style-preset.schema.json",
  "title": "EnFractal style preset",
  "description": "One complete look: renderer settings, light, palette, time of day and seasons, camera and depth of field, post effects, per-material treatments, handmade geometry, procedural charm and the offline restyle recipe. Owned by the Look track. Stored as game/styles/<preset_id>/v<preset_version>.json. A seed or draft version may be edited in place; once a version is candidate or approved, or anything pins it, its file never changes and a change means a new version file. Rooms and saves pin a preset by id, version and file hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "preset_id",
    "preset_version",
    "display_name",
    "status",
    "renderer",
    "palette",
    "lighting",
    "time_of_day",
    "seasons",
    "camera",
    "post",
    "materials",
    "geometry",
    "charm",
    "restyle",
    "budgets"
  ],
  "properties": {
    "schema": {
      "const": "enfractal.style"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "preset_id": {
      "$ref": "common.schema.json#/$defs/token"
    },
    "preset_version": {
      "type": "integer",
      "minimum": 1
    },
    "display_name": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/display_text"
        },
        {
          "maxLength": 80
        }
      ],
      "minLength": 1
    },
    "description": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/long_text"
        },
        {
          "maxLength": 2000
        }
      ]
    },
    "status": {
      "description": "seed: starting values, not reviewed; draft: in development; candidate: submitted for the look gate; approved: passed the look gate; retired: kept for old saves.",
      "enum": [
        "seed",
        "draft",
        "candidate",
        "approved",
        "retired"
      ]
    },
    "look_bible": {
      "$ref": "common.schema.json#/$defs/repo_path"
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "gi",
        "shadows",
        "ambient_occlusion",
        "glow",
        "tonemap"
      ],
      "properties": {
        "method": {
          "description": "Renderer the preset is designed for. The project setting is integrator-owned; the runtime reports a mismatch rather than failing.",
          "enum": [
            "forward_plus",
            "mobile",
            "gl_compatibility"
          ]
        },
        "gi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "energy"
          ],
          "properties": {
            "mode": {
              "enum": [
                "voxelgi",
                "sdfgi",
                "lightmap",
                "none"
              ]
            },
            "energy": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            "bounce_feedback": {
              "$ref": "common.schema.json#/$defs/unit_interval"
            }
          }
        },
        "shadows": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "softness": {
              "$ref": "common.schema.json#/$defs/unit_interval"
            },
            "tint": {
              "$ref": "common.schema.json#/$defs/color_hex"
            }
          }
        },
        "ambient_occlusion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            "radius_m": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 4
            }
          }
        },
        "glow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 8
            },
            "bloom": {
              "$ref": "common.schema.json#/$defs/unit_interval"
            }
          }
        },
        "tonemap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "exposure"
          ],
          "properties": {
            "mode": {
              "enum": [
                "linear",
                "reinhard",
                "filmic",
                "aces",
                "agx"
              ]
            },
            "exposure": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 8
            },
            "white": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 16
            }
          }
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "saturation",
        "contrast",
        "warmth",
        "shadow_tint",
        "highlight_tint"
      ],
      "properties": {
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "contrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "warmth": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "shadow_tint": {
          "$ref": "common.schema.json#/$defs/color_hex"
        },
        "highlight_tint": {
          "$ref": "common.schema.json#/$defs/color_hex"
        },
        "accents": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "common.schema.json#/$defs/color_hex"
          }
        }
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "ambient",
        "honor_room_lights"
      ],
      "properties": {
        "key": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "energy",
            "elevation_deg",
            "azimuth_deg",
            "casts_shadows"
          ],
          "properties": {
            "color": {
              "$ref": "common.schema.json#/$defs/color_hex"
            },
            "energy": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            },
            "elevation_deg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "azimuth_deg": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "casts_shadows": {
              "type": "boolean"
            }
          }
        },
        "ambient": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "energy"
          ],
          "properties": {
            "color": {
              "$ref": "common.schema.json#/$defs/color_hex"
            },
            "energy": {
              "type": "number",
              "minimum": 0,
              "maximum": 8
            }
          }
        },
        "background": {
          "$ref": "common.schema.json#/$defs/color_hex"
        },
        "honor_room_lights": {
          "description": "How strongly captured light hints become real lights: 0 ignores them, 1 uses their estimated intensity.",
          "$ref": "common.schema.json#/$defs/unit_interval"
        },
        "room_light_energy_scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "time_of_day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "default_hour",
        "follow_clock",
        "keys"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "default_hour": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 24
        },
        "follow_clock": {
          "type": "boolean"
        },
        "keys": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hour",
              "key_color",
              "key_energy",
              "ambient_color",
              "ambient_energy"
            ],
            "properties": {
              "hour": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 24
              },
              "key_color": {
                "$ref": "common.schema.json#/$defs/color_hex"
              },
              "key_energy": {
                "type": "number",
                "minimum": 0,
                "maximum": 16
              },
              "ambient_color": {
                "$ref": "common.schema.json#/$defs/color_hex"
              },
              "ambient_energy": {
                "type": "number",
                "minimum": 0,
                "maximum": 8
              }
            }
          }
        }
      }
    },
    "seasons": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "follow_calendar",
        "hemisphere",
        "grades"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "follow_calendar": {
          "type": "boolean"
        },
        "hemisphere": {
          "enum": [
            "north",
            "south"
          ]
        },
        "grades": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spring",
            "summer",
            "autumn",
            "winter"
          ],
          "properties": {
            "spring": {
              "$ref": "#/$defs/grade"
            },
            "summer": {
              "$ref": "#/$defs/grade"
            },
            "autumn": {
              "$ref": "#/$defs/grade"
            },
            "winter": {
              "$ref": "#/$defs/grade"
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fov_deg",
        "depth_of_field",
        "tilt_shift"
      ],
      "properties": {
        "fov_deg": {
          "type": "number",
          "minimum": 30,
          "maximum": 110
        },
        "depth_of_field": {
          "description": "The player's reach stays crisp; the far room softens; foliage or props very close to the camera blur so the player stays visible.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "focus",
            "focus_band_m",
            "far_blur",
            "near_blur",
            "near_blur_distance_m"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "focus": {
              "enum": [
                "player",
                "companion",
                "cursor",
                "fixed"
              ]
            },
            "focus_band_m": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20
            },
            "far_blur": {
              "$ref": "common.schema.json#/$defs/unit_interval"
            },
            "near_blur": {
              "$ref": "common.schema.json#/$defs/unit_interval"
            },
            "near_blur_distance_m": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          }
        },
        "tilt_shift": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "strength"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "strength": {
              "$ref": "common.schema.json#/$defs/unit_interval"
            }
          }
        }
      }
    },
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kuwahara",
        "outline",
        "grain",
        "vignette"
      ],
      "properties": {
        "kuwahara": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "radius_px": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "sharpness": {
              "type": "number",
              "minimum": 0,
              "maximum": 32
            },
            "world_space_orientation": {
              "type": "boolean"
            }
          }
        },
        "outline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "color": {
              "$ref": "common.schema.json#/$defs/color_hex"
            },
            "width_px": {
              "type": "number",
              "minimum": 0,
              "maximum": 8
            }
          }
        },
        "grain": {
          "$ref": "common.schema.json#/$defs/unit_interval"
        },
        "vignette": {
          "$ref": "common.schema.json#/$defs/unit_interval"
        }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "roles"
      ],
      "properties": {
        "default": {
          "$ref": "#/$defs/material_treatment"
        },
        "roles": {
          "description": "Overrides per material role; roles not listed use the default treatment.",
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/material_role"
          },
          "additionalProperties": {
            "$ref": "#/$defs/material_treatment"
          }
        }
      }
    },
    "geometry": {
      "description": "Handmade treatment applied to assets and shell at import or build time.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bevel_m",
        "wobble_m",
        "silhouette_softening",
        "decimation_ratio"
      ],
      "properties": {
        "bevel_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.05
        },
        "wobble_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.02
        },
        "silhouette_softening": {
          "$ref": "common.schema.json#/$defs/unit_interval"
        },
        "decimation_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "charm": {
      "description": "Procedural detail that emerges on surfaces: moss, vines, crumbs, trim. Decoration only; it never changes collision or protection.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "seed",
        "kinds",
        "density"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "kinds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "enum": [
              "moss",
              "vines",
              "grass_tufts",
              "flowers",
              "mushrooms",
              "pebbles",
              "crumbs",
              "dust_bunnies",
              "cobwebs",
              "trim",
              "lanterns",
              "bunting",
              "clutter"
            ]
          }
        },
        "density": {
          "description": "0 to 1 per surface kind.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "floor_edges": {
              "$ref": "common.schema.json#/$defs/unit_interval"
            },
            "wall_bases": {
              "$ref": "common.schema.json#/$defs/unit_interval"
            },
            "object_tops": {
              "$ref": "common.schema.json#/$defs/unit_interval"
            },
            "creations": {
              "$ref": "common.schema.json#/$defs/unit_interval"
            },
            "outdoor_ground": {
              "$ref": "common.schema.json#/$defs/unit_interval"
            }
          }
        }
      }
    },
    "restyle": {
      "description": "Offline per-asset texture restyle recipe for this preset.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "none",
            "img2img_atlas",
            "reference_paint"
          ]
        },
        "prompt": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/long_text"
            },
            {
              "maxLength": 1000
            }
          ]
        },
        "negative_prompt": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/long_text"
            },
            {
              "maxLength": 1000
            }
          ]
        },
        "references": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "common.schema.json#/$defs/repo_path"
          }
        },
        "strength": {
          "$ref": "common.schema.json#/$defs/unit_interval"
        },
        "conditioning": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 4,
          "items": {
            "enum": [
              "depth",
              "normal",
              "canny",
              "ambient_occlusion"
            ]
          }
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_frame_ms",
        "max_shadowed_lights"
      ],
      "properties": {
        "target_frame_ms": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "max_shadowed_lights": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "reference_gpu": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/display_text"
            },
            {
              "maxLength": 80
            }
          ]
        }
      }
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "$defs": {
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "saturation",
        "warmth",
        "tint"
      ],
      "properties": {
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "warmth": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "tint": {
          "$ref": "common.schema.json#/$defs/color_hex"
        }
      }
    },
    "material_treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "albedo_softening",
        "stroke_normal_strength",
        "edge_wear",
        "roughness"
      ],
      "properties": {
        "tint": {
          "$ref": "common.schema.json#/$defs/color_hex"
        },
        "albedo_softening": {
          "$ref": "common.schema.json#/$defs/unit_interval"
        },
        "stroke_normal_strength": {
          "$ref": "common.schema.json#/$defs/unit_interval"
        },
        "edge_wear": {
          "$ref": "common.schema.json#/$defs/unit_interval"
        },
        "roughness": {
          "$ref": "common.schema.json#/$defs/unit_interval"
        },
        "metallic": {
          "$ref": "common.schema.json#/$defs/unit_interval"
        },
        "texture": {
          "description": "Godot resource path of a painted texture, for example res://assets/art/painterly/textures/ground-paint-v1.png.",
          "type": "string",
          "pattern": "^res://[A-Za-z0-9_./-]{1,200}$"
        }
      }
    }
  }
}
