{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enfractal.invalid/v1/game-command.schema.json",
  "title": "EnFractal game messages: command, query and result",
  "description": "The single path for every world change. Manual controls, the AI companion adapter and tests send the same commands. The principal is never part of a request: the trusted adapter assigns it and the result echoes it for audit. A command is idempotent per principal and action_id. Queries are read-only and need no action_id. Validation here is structural; the host still checks bounds, protection, budgets, approvals and the creation compiler.",
  "type": "object",
  "required": ["schema"],
  "properties": {
    "schema": { "enum": ["enfractal.command", "enfractal.query", "enfractal.result"] }
  },
  "allOf": [
    { "if": { "properties": { "schema": { "const": "enfractal.command" } }, "required": ["schema"] }, "then": { "$ref": "#/$defs/command" } },
    { "if": { "properties": { "schema": { "const": "enfractal.query" } }, "required": ["schema"] }, "then": { "$ref": "#/$defs/query" } },
    { "if": { "properties": { "schema": { "const": "enfractal.result" } }, "required": ["schema"] }, "then": { "$ref": "#/$defs/result" } }
  ],
  "$defs": {
    "command_op": {
      "enum": [
        "entity.grab", "entity.release", "entity.place", "entity.set_part", "entity.remove", "entity.transform",
        "creation.place", "creation.revise", "creation.activate",
        "protect.lock", "protect.unlock",
        "goal.set", "goal.stop",
        "effect.start", "effect.stop",
        "style.set",
        "room.checkpoint", "room.undo"
      ]
    },
    "query_op": {
      "enum": ["room.describe", "entities.list", "entity.inspect", "capabilities.list", "observe", "jobs.status", "receipt.lookup"]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "action_id", "room_id", "expected_revision", "op", "args"],
      "properties": {
        "schema": { "const": "enfractal.command" },
        "version": { "const": 1 },
        "action_id": { "$ref": "common.schema.json#/$defs/action_id" },
        "room_id": { "$ref": "common.schema.json#/$defs/token" },
        "expected_revision": {
          "description": "Room revision the sender saw. Any committed change, including a permission or lock change, increments it.",
          "type": "integer",
          "minimum": 0
        },
        "op": { "$ref": "#/$defs/command_op" },
        "args": { "type": "object" },
        "preview": {
          "description": "Validate and predict without committing. A preview records no receipt, so the same action_id can then be committed.",
          "type": "boolean"
        },
        "approval": {
          "description": "Issued by the game UI to the player for one exact command (op, args, targets, room, expected_revision) with an expiry. A model cannot mint one; the host rejects any mismatch.",
          "type": "object",
          "additionalProperties": false,
          "required": ["approval_id"],
          "properties": {
            "approval_id": { "$ref": "common.schema.json#/$defs/token" }
          }
        },
        "note": {
          "description": "Optional human-readable reason shown in the UI and logs. Untrusted text; never interpreted.",
          "type": "string",
          "maxLength": 280
        }
      },
      "allOf": [
        { "if": { "$ref": "#/$defs/is_op/entity.grab" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/entity.grab" } } } },
        { "if": { "$ref": "#/$defs/is_op/entity.release" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/entity.release" } } } },
        { "if": { "$ref": "#/$defs/is_op/entity.place" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/entity.place" } } } },
        { "if": { "$ref": "#/$defs/is_op/entity.set_part" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/entity.set_part" } } } },
        { "if": { "$ref": "#/$defs/is_op/entity.remove" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/target_only" } } } },
        { "if": { "$ref": "#/$defs/is_op/entity.transform" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/entity.transform" } } } },
        { "if": { "$ref": "#/$defs/is_op/creation.place" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/creation.place" } } } },
        { "if": { "$ref": "#/$defs/is_op/creation.revise" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/creation.revise" } } } },
        { "if": { "$ref": "#/$defs/is_op/creation.activate" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/target_only" } } } },
        { "if": { "$ref": "#/$defs/is_op/protect.lock" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/targets_only" } } } },
        { "if": { "$ref": "#/$defs/is_op/protect.unlock" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/targets_only" } } } },
        { "if": { "$ref": "#/$defs/is_op/goal.set" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/goal.set" } } } },
        { "if": { "$ref": "#/$defs/is_op/goal.stop" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/goal.stop" } } } },
        { "if": { "$ref": "#/$defs/is_op/effect.start" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/effect.start" } } } },
        { "if": { "$ref": "#/$defs/is_op/effect.stop" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/effect.stop" } } } },
        { "if": { "$ref": "#/$defs/is_op/style.set" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/style.set" } } } },
        { "if": { "$ref": "#/$defs/is_op/room.checkpoint" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/room.checkpoint" } } } },
        { "if": { "$ref": "#/$defs/is_op/room.undo" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/room.undo" } } } }
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "query_id", "room_id", "op", "args"],
      "properties": {
        "schema": { "const": "enfractal.query" },
        "version": { "const": 1 },
        "query_id": {
          "description": "Correlation id for matching the result; not an idempotency key.",
          "$ref": "common.schema.json#/$defs/action_id"
        },
        "room_id": { "$ref": "common.schema.json#/$defs/token" },
        "op": { "$ref": "#/$defs/query_op" },
        "args": { "type": "object" }
      },
      "allOf": [
        { "if": { "$ref": "#/$defs/is_op/room.describe" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/empty" } } } },
        { "if": { "$ref": "#/$defs/is_op/entities.list" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/entities.list" } } } },
        { "if": { "$ref": "#/$defs/is_op/entity.inspect" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/target_only" } } } },
        { "if": { "$ref": "#/$defs/is_op/capabilities.list" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/capabilities.list" } } } },
        { "if": { "$ref": "#/$defs/is_op/observe" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/observe" } } } },
        { "if": { "$ref": "#/$defs/is_op/jobs.status" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/jobs.status" } } } },
        { "if": { "$ref": "#/$defs/is_op/receipt.lookup" }, "then": { "properties": { "args": { "$ref": "#/$defs/args/receipt.lookup" } } } }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "ok", "op", "principal", "room_id", "revision", "replayed", "preview", "at_utc"],
      "properties": {
        "schema": { "const": "enfractal.result" },
        "version": { "const": 1 },
        "ok": { "type": "boolean" },
        "op": { "anyOf": [ { "$ref": "#/$defs/command_op" }, { "$ref": "#/$defs/query_op" }, { "const": "invalid" } ] },
        "action_id": { "$ref": "common.schema.json#/$defs/action_id" },
        "query_id": { "$ref": "common.schema.json#/$defs/action_id" },
        "principal": { "$ref": "common.schema.json#/$defs/principal_id" },
        "room_id": { "$ref": "common.schema.json#/$defs/token" },
        "revision": {
          "description": "Room revision after a committed command, or the current revision otherwise.",
          "type": "integer",
          "minimum": 0
        },
        "replayed": { "type": "boolean" },
        "preview": { "type": "boolean" },
        "affected": { "type": "array", "maxItems": 256, "items": { "$ref": "common.schema.json#/$defs/entity_id" } },
        "created": { "type": "array", "maxItems": 64, "items": { "$ref": "common.schema.json#/$defs/entity_id" } },
        "job_id": { "$ref": "common.schema.json#/$defs/token" },
        "approval_needed": {
          "description": "Present when the host requires the player to approve this exact command in the UI before it can commit.",
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "expires_utc"],
          "properties": {
            "reason": { "type": "string", "maxLength": 280 },
            "expires_utc": { "$ref": "common.schema.json#/$defs/utc_timestamp" }
          }
        },
        "error": { "$ref": "#/$defs/error" },
        "data": { "type": "object" },
        "at_utc": { "$ref": "common.schema.json#/$defs/utc_timestamp" }
      },
      "allOf": [
        { "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] }, "then": { "not": { "required": ["error"] } }, "else": { "required": ["error"] } },
        { "if": { "properties": { "ok": { "const": true }, "op": { "const": "entities.list" } }, "required": ["ok", "op"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/data/entities.list" } } } },
        { "if": { "properties": { "ok": { "const": true }, "op": { "const": "entity.inspect" } }, "required": ["ok", "op"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/data/entity.inspect" } } } },
        { "if": { "properties": { "ok": { "const": true }, "op": { "const": "observe" } }, "required": ["ok", "op"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/data/observe" } } } },
        { "if": { "properties": { "ok": { "const": true }, "op": { "const": "receipt.lookup" } }, "required": ["ok", "op"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/data/receipt.lookup" } } } }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "$ref": "#/$defs/error_code" },
        "message": {
          "description": "Plain language for the player or the companion to relay. No paths, stack traces, SQL or credentials.",
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "field_path": { "type": "string", "maxLength": 200 },
        "retryable": { "type": "boolean" },
        "allowed": {},
        "actual": {}
      }
    },
    "error_code": {
      "enum": [
        "request_invalid", "version_unsupported", "field_unknown", "action_id_invalid", "action_id_conflict",
        "revision_conflict", "room_mismatch", "not_ready",
        "principal_unknown", "permission_denied", "actor_denied",
        "approval_required", "approval_mismatch", "approval_expired",
        "target_not_found", "target_protected", "target_busy", "target_too_heavy",
        "out_of_bounds", "occupied", "unsupported_capability", "invalid_args",
        "budget_exceeded", "rate_limited", "receipt_limit", "state_limit",
        "persistence_uncertain", "internal_error"
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_m"],
      "properties": {
        "position_m": { "$ref": "common.schema.json#/$defs/vec3" },
        "rotation": { "$ref": "common.schema.json#/$defs/quat_xyzw" },
        "on": {
          "description": "Entity the placed thing should rest on; the host snaps to its walkable top or rejects.",
          "$ref": "common.schema.json#/$defs/entity_id"
        }
      }
    },
    "avatar_id": {
      "type": "string",
      "pattern": "^avatar:[A-Za-z0-9_-]{1,64}$"
    },
    "creation_source": {
      "description": "An enfractal.creation manifest. The creation compiler is its authority; this contract only checks the envelope.",
      "type": "object",
      "required": ["schema"],
      "properties": { "schema": { "const": "enfractal.creation" } }
    },
    "entity_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "display_name", "position_m", "bounds_m", "affordances", "movable", "protected", "provenance_kind"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/entity_id" },
        "kind": { "enum": ["shell", "object", "creation", "avatar", "effect"] },
        "display_name": { "type": "string", "maxLength": 80 },
        "category": { "type": "string", "maxLength": 60 },
        "category_group": { "$ref": "common.schema.json#/$defs/category_group" },
        "position_m": { "$ref": "common.schema.json#/$defs/vec3" },
        "bounds_m": { "$ref": "common.schema.json#/$defs/aabb" },
        "affordances": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/affordance" } },
        "movable": { "type": "boolean" },
        "protected": { "type": "boolean" },
        "provenance_kind": { "$ref": "common.schema.json#/$defs/provenance_kind" },
        "held_by": { "$ref": "#/$defs/avatar_id" }
      }
    },
    "is_op": {
      "entity.grab": { "properties": { "op": { "const": "entity.grab" } }, "required": ["op"] },
      "entity.release": { "properties": { "op": { "const": "entity.release" } }, "required": ["op"] },
      "entity.place": { "properties": { "op": { "const": "entity.place" } }, "required": ["op"] },
      "entity.set_part": { "properties": { "op": { "const": "entity.set_part" } }, "required": ["op"] },
      "entity.remove": { "properties": { "op": { "const": "entity.remove" } }, "required": ["op"] },
      "entity.transform": { "properties": { "op": { "const": "entity.transform" } }, "required": ["op"] },
      "creation.place": { "properties": { "op": { "const": "creation.place" } }, "required": ["op"] },
      "creation.revise": { "properties": { "op": { "const": "creation.revise" } }, "required": ["op"] },
      "creation.activate": { "properties": { "op": { "const": "creation.activate" } }, "required": ["op"] },
      "protect.lock": { "properties": { "op": { "const": "protect.lock" } }, "required": ["op"] },
      "protect.unlock": { "properties": { "op": { "const": "protect.unlock" } }, "required": ["op"] },
      "goal.set": { "properties": { "op": { "const": "goal.set" } }, "required": ["op"] },
      "goal.stop": { "properties": { "op": { "const": "goal.stop" } }, "required": ["op"] },
      "effect.start": { "properties": { "op": { "const": "effect.start" } }, "required": ["op"] },
      "effect.stop": { "properties": { "op": { "const": "effect.stop" } }, "required": ["op"] },
      "style.set": { "properties": { "op": { "const": "style.set" } }, "required": ["op"] },
      "room.checkpoint": { "properties": { "op": { "const": "room.checkpoint" } }, "required": ["op"] },
      "room.undo": { "properties": { "op": { "const": "room.undo" } }, "required": ["op"] },
      "room.describe": { "properties": { "op": { "const": "room.describe" } }, "required": ["op"] },
      "entities.list": { "properties": { "op": { "const": "entities.list" } }, "required": ["op"] },
      "entity.inspect": { "properties": { "op": { "const": "entity.inspect" } }, "required": ["op"] },
      "capabilities.list": { "properties": { "op": { "const": "capabilities.list" } }, "required": ["op"] },
      "observe": { "properties": { "op": { "const": "observe" } }, "required": ["op"] },
      "jobs.status": { "properties": { "op": { "const": "jobs.status" } }, "required": ["op"] },
      "receipt.lookup": { "properties": { "op": { "const": "receipt.lookup" } }, "required": ["op"] }
    },
    "args": {
      "empty": { "type": "object", "additionalProperties": false },
      "target_only": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target"],
        "properties": { "target": { "$ref": "common.schema.json#/$defs/entity_id" } }
      },
      "targets_only": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targets"],
        "properties": {
          "targets": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/entity_id" } }
        }
      },
      "entity.grab": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target"],
        "properties": {
          "target": { "$ref": "common.schema.json#/$defs/entity_id" },
          "actor": { "description": "Defaults to the principal's own avatar. A player may direct the companion; a companion may not direct the player.", "$ref": "#/$defs/avatar_id" }
        }
      },
      "entity.release": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actor": { "$ref": "#/$defs/avatar_id" },
          "placement": { "$ref": "#/$defs/placement" }
        }
      },
      "entity.place": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "placement"],
        "properties": {
          "target": { "$ref": "common.schema.json#/$defs/entity_id" },
          "placement": { "$ref": "#/$defs/placement" }
        }
      },
      "entity.set_part": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "part_id", "value"],
        "properties": {
          "target": { "$ref": "common.schema.json#/$defs/entity_id" },
          "part_id": { "$ref": "common.schema.json#/$defs/token" },
          "value": { "$ref": "common.schema.json#/$defs/unit_interval" }
        }
      },
      "entity.transform": {
        "description": "Turn an entity into something else while keeping its identity, protection and history.",
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "into"],
        "properties": {
          "target": { "$ref": "common.schema.json#/$defs/entity_id" },
          "into": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source"],
            "properties": { "source": { "$ref": "#/$defs/creation_source" } }
          }
        }
      },
      "creation.place": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "placement"],
        "properties": {
          "source": { "$ref": "#/$defs/creation_source" },
          "placement": { "$ref": "#/$defs/placement" }
        }
      },
      "creation.revise": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target"],
        "anyOf": [ { "required": ["source"] }, { "required": ["placement"] } ],
        "properties": {
          "target": { "type": "string", "pattern": "^creation:[A-Za-z0-9_-]{1,64}$" },
          "source": { "$ref": "#/$defs/creation_source" },
          "placement": { "$ref": "#/$defs/placement" }
        }
      },
      "goal.set": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor", "goal"],
        "properties": {
          "actor": { "$ref": "#/$defs/avatar_id" },
          "goal": { "enum": ["follow", "stay", "come", "look_at", "point_at", "go_to", "fetch", "wander"] },
          "target": { "$ref": "common.schema.json#/$defs/entity_id" },
          "position_m": { "$ref": "common.schema.json#/$defs/vec3" },
          "area": { "$ref": "common.schema.json#/$defs/aabb" },
          "duration_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 }
        },
        "allOf": [
          { "if": { "properties": { "goal": { "enum": ["look_at", "point_at", "go_to"] } }, "required": ["goal"] }, "then": { "anyOf": [ { "required": ["target"] }, { "required": ["position_m"] } ] } },
          { "if": { "properties": { "goal": { "const": "fetch" } }, "required": ["goal"] }, "then": { "required": ["target"] } }
        ]
      },
      "goal.stop": {
        "description": "Always permitted and never needs approval. Without an actor it stops every actor the principal may direct, their goals and their effects.",
        "type": "object",
        "additionalProperties": false,
        "properties": { "actor": { "$ref": "#/$defs/avatar_id" } }
      },
      "effect.start": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "params", "area", "duration_s"],
        "properties": {
          "capability": { "$ref": "common.schema.json#/$defs/token" },
          "params": { "type": "object", "maxProperties": 32 },
          "area": {
            "type": "object",
            "additionalProperties": false,
            "required": ["center_m", "radius_m"],
            "properties": {
              "center_m": { "$ref": "common.schema.json#/$defs/vec3" },
              "radius_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 }
            }
          },
          "duration_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 600 },
          "targets": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/entity_id" } }
        }
      },
      "effect.stop": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effect"],
        "properties": {
          "effect": { "anyOf": [ { "type": "string", "pattern": "^effect:[A-Za-z0-9_-]{1,64}$" }, { "const": "all" } ] }
        }
      },
      "style.set": {
        "type": "object",
        "additionalProperties": false,
        "required": ["preset_id", "preset_version"],
        "properties": {
          "preset_id": { "$ref": "common.schema.json#/$defs/token" },
          "preset_version": { "type": "integer", "minimum": 1 }
        }
      },
      "room.checkpoint": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "label": { "type": "string", "maxLength": 80 } }
      },
      "room.undo": {
        "type": "object",
        "additionalProperties": false,
        "required": ["to_revision"],
        "properties": { "to_revision": { "type": "integer", "minimum": 0 } }
      },
      "entities.list": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "filter": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["shell", "object", "creation", "avatar", "effect"] },
              "category_group": { "$ref": "common.schema.json#/$defs/category_group" },
              "affordance": { "$ref": "common.schema.json#/$defs/affordance" },
              "provenance_kind": { "$ref": "common.schema.json#/$defs/provenance_kind" },
              "near": {
                "type": "object",
                "additionalProperties": false,
                "required": ["center_m", "radius_m"],
                "properties": {
                  "center_m": { "$ref": "common.schema.json#/$defs/vec3" },
                  "radius_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 50 }
                }
              }
            }
          },
          "cursor": { "type": "string", "maxLength": 128 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      },
      "capabilities.list": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": { "$ref": "common.schema.json#/$defs/token" },
          "cursor": { "type": "string", "maxLength": 128 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      },
      "observe": {
        "description": "What the actor can currently perceive, limited to its line of sight and radius.",
        "type": "object",
        "additionalProperties": false,
        "required": ["actor"],
        "properties": {
          "actor": { "$ref": "#/$defs/avatar_id" },
          "radius_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 }
        }
      },
      "jobs.status": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id"],
        "properties": { "job_id": { "$ref": "common.schema.json#/$defs/token" } }
      },
      "receipt.lookup": {
        "description": "Reconcile before retrying: ask whether an earlier action committed.",
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id"],
        "properties": { "action_id": { "$ref": "common.schema.json#/$defs/action_id" } }
      }
    },
    "data": {
      "entities.list": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/entity_summary" } },
          "next_cursor": { "type": "string", "maxLength": 128 }
        }
      },
      "entity.inspect": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity"],
        "properties": {
          "entity": { "$ref": "#/$defs/entity_summary" },
          "parts": {
            "type": "object",
            "propertyNames": { "$ref": "common.schema.json#/$defs/token" },
            "additionalProperties": { "$ref": "common.schema.json#/$defs/unit_interval" }
          },
          "protected_by": { "$ref": "common.schema.json#/$defs/principal_id" }
        }
      },
      "observe": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor", "visible", "texts"],
        "properties": {
          "actor": { "$ref": "#/$defs/avatar_id" },
          "visible": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/entity_summary" } },
          "texts": {
            "description": "Words seen in the world (labels, signs, names). Always untrusted: an adapter must never place them in instructions.",
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "text", "untrusted"],
              "properties": {
                "source": { "$ref": "common.schema.json#/$defs/entity_id" },
                "text": { "type": "string", "maxLength": 500 },
                "untrusted": { "const": true }
              }
            }
          }
        }
      },
      "receipt.lookup": {
        "type": "object",
        "additionalProperties": false,
        "required": ["found"],
        "properties": {
          "found": { "type": "boolean" },
          "receipt": { "$ref": "#/$defs/result" }
        }
      }
    }
  }
}
