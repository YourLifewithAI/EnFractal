diff --git a/contracts/README.md b/contracts/README.md
index eb83f67..fab8d8a 100644
--- a/contracts/README.md
+++ b/contracts/README.md
@@ -10,6 +10,7 @@ Run 0 output, 6 October 2026. These schemas are the agreements between the four
 | Style preset | `style-preset.schema.json` | Look (L1, L3, L5, L6) | Look runtime, Capture restyle stage, room and state pins |
 | Command, query, result | `game-command.schema.json` | manual controls (P3, P5), AI adapter (A1), tests | the kernel (P1) and everything that records receipts |
 | Room state | `room-state.schema.json` | saves (P4) | room rebuild (P6), undo, reconcile |
+| Companion link (session file and frames) | `companion-link.schema.json` | the game (session file, its frames), the companion adapter (its frames) | the other side of the link; see `docs/companion/TRANSPORT.md` |
 
 Examples live in `examples/` and are generated by `examples/build_examples.py`. The placeholder room `game/rooms/test_room/` is generated by `tools/rooms/build_test_room.py` and the seed preset is `game/styles/storybook_painterly/v1.json`. The game loads them through `game/scripts/native/Room/` and `game/scripts/native/Look/`.
 
@@ -86,6 +87,6 @@ Captured rooms load at runtime from `user://rooms/`, where the raw `.glb` bytes
 ## Known open points for later runs
 
 - Canonical JSON for command fingerprints and creation `source_sha256` must be byte-identical across GDScript, C# and Python. Run 1's P1 packet owns a shared golden fixture before any cross-language hash is compared.
-- `observe` field-of-view rules, `capabilities.list` payloads and `jobs.status` payloads are A1 deliverables; their result `data` is free-form until then.
+- What a companion perceives (line of sight from its avatar, for every query and command) and remembers is in `docs/companion/PERCEPTION.md`; the kernel host replaces the mock's box geometry with ray casts. A remembered entity is an `entity_summary` as last seen, marked `seen: "remembered"` with `last_seen_ago_s`, `last_seen_revision` and `may_be_stale`; `observe` lists such things under `remembered`. `capabilities.list` and `jobs.status` result payloads are fixed by `$defs/data`. A goal with a target runs as a job: its `goal.set` result carries `job_id`, and `jobs.status` reports how the host's re-check on arrival ended.
 - Health, damage and hit primitives for the dragon scenario arrive with A4 as a version 2 command vocabulary.
 - Shared room libraries (an asset referenced by many rooms) and room-to-room portals need path forms the current `rel_path` rule forbids; they are deliberately out of version 1.
diff --git a/contracts/companion-link.schema.json b/contracts/companion-link.schema.json
new file mode 100644
index 0000000..db7f5e8
--- /dev/null
+++ b/contracts/companion-link.schema.json
@@ -0,0 +1,281 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://contracts.enfractal.invalid/v1/companion-link.schema.json",
+  "title": "EnFractal companion link: session file and frames",
+  "description": "PROPOSED for contracts/ by Lane A (Run 1). The loopback connection between the companion MCP server and the running game. The game listens on 127.0.0.1 or ::1 only and writes the session file to user://companion/session.json with a fresh 256-bit token per launch. Both sides prove knowledge of the token with HMAC-SHA256 over two fresh nonces, so the token never crosses the socket. Each frame is a 4-byte big-endian length followed by one JSON object, which the sender writes as canonical JSON v1 (UTF-8, numbers in canonical form) so that a frame is the canonical message plus a short envelope; readers accept any strict JSON within the limit, and duplicate keys and non-finite numbers are refused. A wrong proof closes only that connection: there is no lockout. The game binds the principal to the authenticated connection; no frame carries a principal, an approval or the token. Request and response frames carry enfractal.command / enfractal.query and enfractal.result messages from game-command.schema.json.",
+  "oneOf": [
+    {
+      "$ref": "#/$defs/session_file"
+    },
+    {
+      "$ref": "#/$defs/hello"
+    },
+    {
+      "$ref": "#/$defs/challenge"
+    },
+    {
+      "$ref": "#/$defs/auth"
+    },
+    {
+      "$ref": "#/$defs/ready"
+    },
+    {
+      "$ref": "#/$defs/refused"
+    },
+    {
+      "$ref": "#/$defs/request"
+    },
+    {
+      "$ref": "#/$defs/response"
+    }
+  ],
+  "$defs": {
+    "hex256": {
+      "type": "string",
+      "pattern": "^[0-9a-f]{64}$"
+    },
+    "session_file": {
+      "description": "user://companion/session.json, written atomically by the game at startup and deleted at exit. Readable only by the player's account. The companion refuses any host that is not a loopback literal.",
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "schema",
+        "version",
+        "host",
+        "port",
+        "token",
+        "room_id",
+        "pid",
+        "created_utc"
+      ],
+      "properties": {
+        "schema": {
+          "const": "enfractal.companion_session"
+        },
+        "version": {
+          "type": "integer",
+          "const": 1
+        },
+        "host": {
+          "enum": [
+            "127.0.0.1",
+            "::1"
+          ]
+        },
+        "port": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 65535
+        },
+        "token": {
+          "description": "256 bits from a CSPRNG, lowercase hex. New every launch. Never sent over the socket.",
+          "$ref": "#/$defs/hex256"
+        },
+        "room_id": {
+          "$ref": "common.schema.json#/$defs/token"
+        },
+        "pid": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 4294967295
+        },
+        "created_utc": {
+          "$ref": "common.schema.json#/$defs/utc_timestamp"
+        }
+      }
+    },
+    "hello": {
+      "description": "Companion to game, first frame.",
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "type",
+        "protocol",
+        "version",
+        "client_nonce"
+      ],
+      "properties": {
+        "type": {
+          "const": "hello"
+        },
+        "protocol": {
+          "const": "enfractal.companion_link"
+        },
+        "version": {
+          "type": "integer",
+          "const": 1
+        },
+        "client_nonce": {
+          "$ref": "#/$defs/hex256"
+        }
+      }
+    },
+    "challenge": {
+      "description": "Game to companion. server_proof = hex(HMAC-SHA256(key = token bytes, msg = 'enfractal.companion_link/1|server|' + client_nonce + '|' + server_nonce)). The companion verifies it before sending anything else, so a listener that does not know the token learns nothing.",
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "type",
+        "protocol",
+        "version",
+        "server_nonce",
+        "server_proof"
+      ],
+      "properties": {
+        "type": {
+          "const": "challenge"
+        },
+        "protocol": {
+          "const": "enfractal.companion_link"
+        },
+        "version": {
+          "type": "integer",
+          "const": 1
+        },
+        "server_nonce": {
+          "$ref": "#/$defs/hex256"
+        },
+        "server_proof": {
+          "$ref": "#/$defs/hex256"
+        }
+      }
+    },
+    "auth": {
+      "description": "Companion to game. client_proof = hex(HMAC-SHA256(key = token bytes, msg = 'enfractal.companion_link/1|client|' + client_nonce + '|' + server_nonce)), compared in constant time.",
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "type",
+        "client_proof"
+      ],
+      "properties": {
+        "type": {
+          "const": "auth"
+        },
+        "client_proof": {
+          "$ref": "#/$defs/hex256"
+        }
+      }
+    },
+    "ready": {
+      "description": "Game to companion after a valid proof. Reports the principal and avatar the game assigned to this connection; the companion never chooses them.",
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "type",
+        "session_id",
+        "principal",
+        "avatar",
+        "room_id",
+        "limits"
+      ],
+      "properties": {
+        "type": {
+          "const": "ready"
+        },
+        "session_id": {
+          "type": "string",
+          "pattern": "^[0-9a-f]{32}$"
+        },
+        "principal": {
+          "$ref": "common.schema.json#/$defs/principal_id"
+        },
+        "avatar": {
+          "type": "string",
+          "pattern": "^avatar:[A-Za-z0-9_-]{1,64}$"
+        },
+        "room_id": {
+          "$ref": "common.schema.json#/$defs/token"
+        },
+        "limits": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "max_request_frame",
+            "max_response_frame"
+          ],
+          "properties": {
+            "max_request_frame": {
+              "type": "integer",
+              "minimum": 65536
+            },
+            "max_response_frame": {
+              "type": "integer",
+              "minimum": 262144
+            }
+          }
+        }
+      }
+    },
+    "refused": {
+      "description": "Game to companion, then the game closes the connection.",
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "type",
+        "code"
+      ],
+      "properties": {
+        "type": {
+          "const": "refused"
+        },
+        "code": {
+          "enum": [
+            "hello_invalid",
+            "handshake_invalid",
+            "handshake_timeout",
+            "auth_failed",
+            "busy",
+            "frame_invalid"
+          ]
+        }
+      }
+    },
+    "request": {
+      "description": "Companion to game. One enfractal.command or enfractal.query. Any other frame type after authentication is frame_invalid and closes the connection.",
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "type",
+        "seq",
+        "message"
+      ],
+      "properties": {
+        "type": {
+          "const": "request"
+        },
+        "seq": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 9007199254740991
+        },
+        "message": {
+          "type": "object"
+        }
+      }
+    },
+    "response": {
+      "description": "Game to companion. Echoes seq; message is one enfractal.result.",
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "type",
+        "seq",
+        "message"
+      ],
+      "properties": {
+        "type": {
+          "const": "response"
+        },
+        "seq": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 9007199254740991
+        },
+        "message": {
+          "type": "object"
+        }
+      }
+    }
+  }
+}
