+        _diorama = new Camera3D { Name = "DioramaCamera", Near = 0.01f, Far = Look?.FarPlaneM ?? 100, Fov = DioramaFovDeg };
         _dioramaArm.AddChild(_diorama);
         PlaceDioramaRig(snap: true);
         IgnoreCollisionOnlyParts();
